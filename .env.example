# =============================================================================
# AZIO environment
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME="AZIO"
# Public origin. Auth.js v5 reads AUTH_URL (not NEXTAUTH_URL).
# Local:
AUTH_URL="http://localhost:3000"
# Production:
# AUTH_URL="https://azio.fun"
# NEXT_PUBLIC_APP_URL="https://azio.fun"
# NEXTAUTH_URL is optional compatibility only; AUTH_URL wins if both are set.

# Auth.js — generate with: openssl rand -base64 32
# Required in every environment.
AUTH_SECRET=""

# Database (PostgreSQL)
# Prisma uses DATABASE_URL only (no DIRECT_URL in this project).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos"
# Local Homebrew example:
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/lifeos"
# Production: set this in the host dashboard to the hosted Postgres URL (TLS).
# Apply schema with: npm run db:migrate:deploy
# Do not use prisma db push against production.

# Google OAuth — login AND Calendar/Gmail integrations (AUTH_GOOGLE_ID, not GOOGLE_CLIENT_ID)
# Google Cloud Console → APIs & Services → Credentials → OAuth client
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://azio.fun
#   https://www.azio.fun
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/integrations/google/callback
#   https://azio.fun/api/auth/callback/google
#   https://azio.fun/api/integrations/google/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Encrypt OAuth tokens at rest (AES-256-GCM). Required in production.
# Generate with: openssl rand -base64 32
# Locally AUTH_SECRET is used as a fallback if this is empty.
INTEGRATION_ENCRYPTION_KEY=""

# GitHub OAuth for integrations (not used for login)
# GitHub → Developer settings → OAuth Apps
# Homepage URL: https://azio.fun
# Authorization callback URL:
#   http://localhost:3000/api/integrations/github/callback
#   https://azio.fun/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis (optional — not required. Queue is PostgreSQL-backed.)
# REDIS_URL is reserved; the in-process cache is used until a Redis store is wired.
REDIS_URL=""

# Background automations
QUEUE_DRIVER="database"
AUTOMATION_WORKER_CONCURRENCY="5"
# AUTOMATION_WORKER_INCLUDE_SCHEDULER="1"
# AUTOMATION_SCHEDULER_INTERVAL_MS="15000"
# AUTOMATION_WORKER_POLL_MS="2000"

# Cron + worker health. Required in production.
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
# WORKER_HEALTH_SECRET=""

# Extra browser origins for CORS (comma-separated). www is also derived from AUTH_URL.
# ALLOWED_ORIGINS="https://www.azio.fun"

# Optional rate-limit overrides
# RATE_LIMIT_AI="20"
# RATE_LIMIT_AI_WINDOW="60"
# RATE_LIMIT_LOGIN="10"
# RATE_LIMIT_LOGIN_WINDOW="900"
# RATE_LIMIT_SIGNUP="5"
# RATE_LIMIT_AGENT="10"
# RATE_LIMIT_GMAIL="10"
# RATE_LIMIT_GITHUB="20"
# RATE_LIMIT_SEARCH="30"
# RATE_LIMIT_BILLING="10"
# RATE_LIMIT_AUTOMATION_CREATE="20"
# RATE_LIMIT_AUTOMATION_RUN="10"

# AI (AZIO Brain) — never expose these to the client. There is no AI_PROVIDER_KEY var;
# use AI_API_KEY (or the provider-specific fallbacks).
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
AI_BASE_URL=""

# Object storage (optional — no user file uploads yet)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# Razorpay billing
# Keep TEST keys until live payments are explicitly enabled.
# Test key prefix: rzp_test_
# Live key prefix: rzp_live_
# Live keys are ignored unless AZIO_ALLOW_LIVE_PAYMENTS=true
# -----------------------------------------------------------------------------
AZIO_ALLOW_LIVE_PAYMENTS="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PRO_PLAN_ID=""
RAZORPAY_PRO_ANNUAL_PLAN_ID=""
# Production TEST webhook URL:
#   https://azio.fun/api/razorpay/webhook
# Production LIVE webhook URL (only after confirmation):
#   https://azio.fun/api/razorpay/webhook

# Production required:
# AUTH_SECRET, DATABASE_URL, AUTH_URL=https://azio.fun,
# INTEGRATION_ENCRYPTION_KEY, CRON_SECRET
# RAZORPAY_WEBHOOK_SECRET if billing is enabled
