# App
NEXT_PUBLIC_APP_NAME="AZIO"
AUTH_URL="http://localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos"
# Local Homebrew example:
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/lifeos"

# Google OAuth (optional — leave empty to hide the Google button)
# Also used for Google Calendar and Gmail integrations.
# Add this authorized redirect URI in Google Cloud Console:
#   {AUTH_URL}/api/integrations/google/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Encrypt OAuth tokens at rest (AES-256-GCM). Required in production.
# Generate with: openssl rand -base64 32
# Locally AUTH_SECRET is used as a fallback if this is empty.
INTEGRATION_ENCRYPTION_KEY=""

# GitHub OAuth for integrations (not used for login)
# Authorized callback URL:
#   {AUTH_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis (optional — not required locally)
# Production recommendation: Redis + BullMQ for the automation worker.
REDIS_URL=""

# Background automations
QUEUE_DRIVER="database"
AUTOMATION_WORKER_CONCURRENCY="5"
# AUTOMATION_WORKER_INCLUDE_SCHEDULER="1"
# AUTOMATION_SCHEDULER_INTERVAL_MS="15000"
# AUTOMATION_WORKER_POLL_MS="2000"

# Optional secret for cron enqueue and worker health.
# Required in production. Do not fall back to a signed-in session.
CRON_SECRET=""
# WORKER_HEALTH_SECRET=""

# Optional extra browser origins for CORS checks (comma-separated)
# ALLOWED_ORIGINS="https://azio.example"

# Optional rate-limit overrides
# RATE_LIMIT_AI="20"
# RATE_LIMIT_AI_WINDOW="60"
# RATE_LIMIT_LOGIN="10"
# RATE_LIMIT_LOGIN_WINDOW="900"
# RATE_LIMIT_SIGNUP="5"
# RATE_LIMIT_AGENT="10"
# RATE_LIMIT_GMAIL="10"
# RATE_LIMIT_GITHUB="20"
# RATE_LIMIT_SEARCH="30"
# RATE_LIMIT_BILLING="10"
# RATE_LIMIT_AUTOMATION_CREATE="20"
# RATE_LIMIT_AUTOMATION_RUN="10"

# Production required (do not leave empty in production):
# AUTH_SECRET, DATABASE_URL, AUTH_URL (https), INTEGRATION_ENCRYPTION_KEY,
# CRON_SECRET, RAZORPAY_WEBHOOK_SECRET (if billing is enabled)

# AI (AZIO Brain) — never expose these to the client
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL=""
# Optional fallbacks if AI_API_KEY is empty
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
# Optional OpenAI-compatible base URL
AI_BASE_URL=""

# Object storage (optional)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Razorpay billing (optional — app runs on Free without these)
# Use TEST MODE keys locally. Never commit live secrets.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Plan IDs from Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_PRO_PLAN_ID=""
RAZORPAY_PRO_ANNUAL_PLAN_ID=""
