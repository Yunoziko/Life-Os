# App
NEXT_PUBLIC_APP_NAME="LifeOS"
AUTH_URL="http://localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos"
# Local Homebrew example:
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/lifeos"

# Google OAuth (optional — leave empty to hide the Google button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (optional — architecture is ready, not required for local)
REDIS_URL=""

# Background jobs (optional)
QUEUE_DRIVER="memory"

# AI providers (optional — do not implement agents in this phase)
AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Object storage (optional)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
