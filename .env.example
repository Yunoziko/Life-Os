# App
NEXT_PUBLIC_APP_NAME="LifeOS"
AUTH_URL="http://localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos"
# Local Homebrew example:
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/lifeos"

# Google OAuth (optional — leave empty to hide the Google button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (optional — architecture is ready, not required for local)
REDIS_URL=""

# Background jobs (optional)
QUEUE_DRIVER="memory"

# AI (LifeOS Brain) — never expose these to the client
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL=""
# Optional fallbacks if AI_API_KEY is empty
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
# Optional OpenAI-compatible base URL
AI_BASE_URL=""

# Object storage (optional)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
