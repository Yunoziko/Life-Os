generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum CalendarEventSource {
  MANUAL
  TASK
  GOAL
  GOOGLE
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  GMAIL
  GITHUB
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum ExternalSyncOrigin {
  IMPORTED
  PUSHED
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LearningType {
  COURSE
  BOOK
  ARTICLE
  VIDEO
  PODCAST
  OTHER
}

enum BillingPlan {
  FREE
  PRO
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
  PAUSED
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AgentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AgentRunStatus {
  PLANNING
  EXECUTING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationTriggerType {
  MANUAL
  SCHEDULE
  EVENT
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
  AWAITING_CONFIRMATION
}

enum NotificationChannel {
  IN_APP
}

enum MemoryType {
  PREFERENCE
  GOAL_CONTEXT
  PROJECT_CONTEXT
  ROUTINE
  DECISION
  IMPORTANT_CONTEXT
  WORKFLOW
  PERSONALIZATION
}

enum MemoryStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MemorySource {
  USER
  AI
  NOTE
  TASK
  PROJECT
  CONVERSATION
}

enum MemoryImportance {
  HIGH
  MEDIUM
  LOW
}

enum MemoryConfidence {
  HIGH
  MEDIUM
  LOW
}

enum NotificationType {
  AUTOMATION_COMPLETED
  AUTOMATION_FAILED
  AUTOMATION_WAITING
  DAILY_BRIEF_READY
  WEEKLY_REVIEW_READY
  SYSTEM
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
  profile       Profile?
  tasks         Task[]
  goals         Goal[]
  projects      Project[]
  notes         Note[]
  habits        Habit[]
  habitLogs     HabitLog[]
  events        CalendarEvent[]
  conversations AIConversation[]
  milestones    Milestone[]
  learningItems LearningItem[]
  integrations   IntegrationAccount[]
  externalMaps   ExternalItemMapping[]
  subscriptions  Subscription[]
  paymentOrders  PaymentOrder[]
  aiUsage        AIUsage[]
  agents         Agent[]
  agentRuns      AgentRun[]
  automations    Automation[]
  auditLogs      AgentAuditLog[]
  notifications  Notification[]
  memories       Memory[]

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID        String  @unique
  userId              String
  providerAccountId   String
  credentialPublicKey String
  counter             Int
  credentialDeviceType String
  credentialBackedUp  Boolean
  transports          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  timezone    String   @default("UTC")
  weekStartsOn Int     @default(1)
  bio         String?
  memoryEnabled Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  projectId   String?
  goalId      String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NONE)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, priority])
  @@index([userId, completedAt])
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([goalId])
}

model Goal {
  id          String       @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String?
  status      GoalStatus   @default(ACTIVE)
  priority    GoalPriority @default(MEDIUM)
  targetDate  DateTime?
  progress    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  projects      Project[]
  milestones    Milestone[]
  habits        Habit[]
  notes         Note[]
  events        CalendarEvent[]
  learningItems LearningItem[]
  memories      Memory[]

  @@index([userId, status])
  @@index([userId, priority])
}

model Milestone {
  id        String    @id @default(uuid())
  userId    String
  goalId    String
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, completed])
  @@index([userId, goalId])
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  goalId      String?
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String?
  icon        String?
  githubRepo  String?
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks         Task[]
  notes         Note[]
  events        CalendarEvent[]
  learningItems LearningItem[]
  memories      Memory[]

  @@index([userId, status])
  @@index([goalId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  goalId    String?
  title     String
  content   String   @default("")
  preview   String   @default("")
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, pinned, archived])
  @@index([projectId])
  @@index([goalId])
}

model Habit {
  id          String         @id @default(uuid())
  userId      String
  goalId      String?
  name        String
  description String?
  frequency   HabitFrequency @default(DAILY)
  target      String?
  startDate   DateTime?
  endDate     DateTime?
  paused      Boolean        @default(false)
  archived    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]

  @@index([userId, archived])
  @@index([goalId])
}

model HabitLog {
  id        String   @id @default(uuid())
  userId    String
  habitId   String
  date      DateTime
  completed Boolean  @default(true)
  value     Int?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model CalendarEvent {
  id              String              @id @default(uuid())
  userId          String
  projectId       String?
  goalId          String?
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean             @default(false)
  location        String?
  color           String?
  recurrence      String?
  reminderMinutes Int?
  source          CalendarEventSource @default(MANUAL)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal        Goal?                @relation(fields: [goalId], references: [id], onDelete: SetNull)
  externalMap ExternalItemMapping?

  @@index([userId, startAt])
  @@index([projectId])
  @@index([goalId])
}

model LearningItem {
  id          String         @id @default(uuid())
  userId      String
  goalId      String?
  projectId   String?
  title       String
  description String?
  type        LearningType   @default(COURSE)
  status      LearningStatus @default(NOT_STARTED)
  url         String?
  provider    String?
  progress    Int            @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([goalId])
  @@index([projectId])
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AIMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model IntegrationAccount {
  id                    String              @id @default(uuid())
  userId                String
  provider              IntegrationProvider
  status                IntegrationStatus   @default(CONNECTED)
  accountLabel          String?
  scopes                String[]            @default([])
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenType             String?
  expiresAt             DateTime?
  lastSyncAt            DateTime?
  lastError             String?
  connectedAt           DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mappings ExternalItemMapping[]

  @@unique([userId, provider])
  @@index([userId, status])
}

model ExternalItemMapping {
  id            String              @id @default(uuid())
  userId        String
  integrationId String
  provider      IntegrationProvider
  externalId    String
  calendarId    String?
  lifeOSEventId String?             @unique
  origin        ExternalSyncOrigin
  etag          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration IntegrationAccount @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event       CalendarEvent?     @relation(fields: [lifeOSEventId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, externalId])
  @@index([userId, provider])
  @@index([integrationId])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  provider               String             @default("razorpay")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  providerOrderId        String?
  plan                   BillingPlan        @default(PRO)
  interval               BillingInterval    @default(MONTHLY)
  status                 SubscriptionStatus @default(CREATED)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  lastPaymentError       String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentOrders PaymentOrder[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model PaymentOrder {
  id                String             @id @default(uuid())
  userId            String
  subscriptionId    String?
  plan              BillingPlan        @default(PRO)
  interval          BillingInterval
  amountPaise       Int
  currency          String             @default("INR")
  razorpayOrderId   String             @unique
  razorpayPaymentId String?            @unique
  status            PaymentOrderStatus @default(CREATED)
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model AIUsage {
  id           String   @id @default(uuid())
  userId       String
  periodStart  DateTime
  periodEnd    DateTime
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId])
}

model BillingWebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventKey    String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Agent {
  id          String      @id @default(uuid())
  userId      String
  name        String
  description String?
  status      AgentStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AgentRun[]

  @@index([userId, status])
}

model AgentRun {
  id              String         @id @default(uuid())
  userId          String
  agentId         String
  automationRunId String?        @unique
  conversationId  String?
  status          AgentRunStatus @default(PLANNING)
  goal            String
  plan            Json?
  steps           Json?
  summary         String?
  error           String?
  failureClass    String?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  automationRun  AutomationRun?  @relation(fields: [automationRunId], references: [id], onDelete: SetNull)
  auditLogs      AgentAuditLog[]

  @@index([userId, startedAt])
  @@index([agentId, startedAt])
  @@index([status])
}

model Automation {
  id           String                 @id @default(uuid())
  userId       String
  name         String
  description  String?
  triggerType  AutomationTriggerType
  actionType   String
  enabled      Boolean                @default(true)
  timezone     String                 @default("UTC")
  pauseReason  String?
  schedule     Json?
  eventType    String?
  actionConfig Json?
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([userId, enabled])
  @@index([enabled, nextRunAt])
  @@index([userId, eventType])
  @@index([userId, createdAt])
}

model AutomationRun {
  id              String              @id @default(uuid())
  automationId    String
  status          AutomationRunStatus @default(QUEUED)
  idempotencyKey  String              @unique
  scheduledFor    DateTime?
  attemptCount    Int                 @default(0)
  availableAt     DateTime            @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  errorCategory   String?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  error           String?
  result          Json?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  agentRun   AgentRun?

  @@unique([automationId, scheduledFor])
  @@index([automationId, startedAt])
  @@index([status, availableAt])
  @@index([status])
}

model AgentAuditLog {
  id         String   @id @default(uuid())
  userId     String
  agentRunId String?
  tool       String
  action     String
  status     String
  timestamp  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([agentRunId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      NotificationType    @default(SYSTEM)
  title     String
  body      String
  href      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
}

model WorkerHeartbeat {
  id            String    @id
  status        String    @default("stopped")
  lastTickAt    DateTime?
  lastSuccessAt DateTime?
  queueDepth    Int       @default(0)
  runningCount  Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

model Memory {
  id          String            @id @default(uuid())
  userId      String
  type        MemoryType
  content     String
  source      MemorySource      @default(USER)
  importance  MemoryImportance  @default(MEDIUM)
  confidence  MemoryConfidence  @default(HIGH)
  status      MemoryStatus      @default(ACTIVE)
  projectId   String?
  goalId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lastUsedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, type, status])
  @@index([userId, importance, lastUsedAt])
  @@index([userId, projectId])
  @@index([userId, goalId])
  @@index([userId, createdAt])
}

